# Numero de navegadores (contextos) corriendo en paralelo
CONCURRENCY=3

# true = sin ventana visible. Pon false para depurar visualmente.
HEADLESS=true

# Lista de proxies separados por coma, formato: http://usuario:pass@host:puerto
# Vacio = sin proxy (NO recomendado a volumen alto, Google bloqueara la IP rapido)
PROXIES=

# Rango de espera (segundos) entre acciones para simular comportamiento humano
MIN_DELAY=1.5
MAX_DELAY=4.0

# Cuantos resultados intentar extraer por busqueda como maximo
DEFAULT_LIMIT=60

# Rutas de datos
DB_PATH=data/gmaps.db
SCREENSHOT_DIR=logs/screenshots
